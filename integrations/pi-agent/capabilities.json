{
  "schema_version": "kendr.host-capabilities/v1",
  "adapter": "@kendr/optimizer-pi",
  "host": "pi",
  "audited_package": "@earendil-works/pi-coding-agent",
  "audited_host_version": "0.84.1",
  "audited_host_commit": "53fa77ccd8a279eb87e92294ef3687b03ff80112",
  "provider_egress": false,
  "stores_provider_credentials": false,
  "default_risk_ceiling": "representation_safe",
  "fail_open": true,
  "transforms": {
    "system_prompt": {
      "mode": "apply",
      "hook": "before_agent_start.systemPrompt"
    },
    "context_messages": {
      "mode": "apply",
      "hook": "context.messages"
    },
    "tool_result": {
      "mode": "apply",
      "hook": "tool_result.content",
      "preserved_fields": ["details", "isError", "usage", "images"]
    },
    "assistant_output": {
      "mode": "shadow_only_opt_in",
      "hook": "message_end",
      "reason": "A finalized output is already billed; rewriting it cannot reduce provider output tokens."
    },
    "tool_selection": {
      "mode": "disabled",
      "reason": "Pi can set active tools, but the extension seam does not guarantee an automatic full-tool retry."
    },
    "tool_definition_rewrite": {
      "mode": "unsupported"
    },
    "provider_payload": {
      "mode": "unsupported",
      "reason": "before_provider_request is provider-specific and is intentionally outside this provider-neutral adapter."
    },
    "generation_controls": {
      "mode": "unsupported"
    }
  },
  "core_host_capabilities": {
    "can_narrow_tools": false,
    "can_restore_references": false,
    "can_retry_with_full_tools": false,
    "streaming_output": true,
    "can_set_max_output_tokens": false,
    "can_set_verbosity": false,
    "can_append_generation_policy": false
  }
}
