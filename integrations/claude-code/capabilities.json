{
  "schema_version": "kendr.host-capabilities/v1",
  "adapter": "@kendr/optimizer-claude-code",
  "host": "claude-code",
  "audited_host_version": "2.1.224",
  "audited_host_commit": "66edf5358349356774812264b75b8ea792f0d0a3",
  "provider_egress": false,
  "stores_provider_credentials": false,
  "default_risk_ceiling": "representation_safe",
  "fail_open": true,
  "transforms": {
    "current_prompt": {
      "mode": "shadow_only",
      "reason": "UserPromptSubmit can add context but cannot replace the submitted prompt."
    },
    "successful_tool_result": {
      "mode": "apply",
      "hook": "PostToolUse.updatedToolOutput"
    },
    "failed_tool_result": {
      "mode": "unsupported",
      "reason": "PostToolUseFailure cannot replace failed tool output."
    },
    "history": {
      "mode": "unsupported"
    },
    "tool_definitions": {
      "mode": "unsupported"
    },
    "assistant_output": {
      "mode": "shadow_only",
      "hook": "Stop"
    },
    "generation_controls": {
      "mode": "unsupported"
    }
  },
  "core_host_capabilities": {
    "can_narrow_tools": false,
    "can_restore_references": false,
    "can_retry_with_full_tools": false,
    "streaming_output": true,
    "can_set_max_output_tokens": false,
    "can_set_verbosity": false,
    "can_append_generation_policy": false
  }
}
