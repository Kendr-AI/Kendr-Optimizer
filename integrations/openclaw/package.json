{
  "name": "@kendr/optimizer-openclaw",
  "version": "0.1.2",
  "description": "Fail-open OpenClaw context-engine adapter for the local Kendr Optimizer transform service",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kendr-AI/Kendr-Optimizer.git",
    "directory": "integrations/openclaw"
  },
  "homepage": "https://github.com/Kendr-AI/Kendr-Optimizer/tree/main/integrations/openclaw#readme",
  "bugs": {
    "url": "https://github.com/Kendr-AI/Kendr-Optimizer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist/index.js",
    "dist/index.d.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/index.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2 <2027"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2 <2027",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.2",
      "pluginSdkVersion": "2026.7.2",
      "auditedCommit": "60fc2fe64d8ec2988a555a638dc1074d31e5760b"
    }
  }
}
